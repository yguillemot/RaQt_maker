        MV_WATCHOS_2_1 = (QSysInfo::MV_WATCHOS | 2 << 4 | 1),
        MV_WATCHOS_2_2 = (QSysInfo::MV_WATCHOS | 2 << 4 | 2),
        MV_WATCHOS_3_0 = (QSysInfo::MV_WATCHOS | 3 << 4 | 0)
    };

