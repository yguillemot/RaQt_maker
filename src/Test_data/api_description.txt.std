class QOpenGLBuffer
{

public:
enum Type {
        VertexBuffer = 0x8892,
        IndexBuffer = 0x8893,
        PixelPackBuffer = 0x88EB,
        PixelUnpackBuffer = 0x88EC
    };

QOpenGLBuffer();
