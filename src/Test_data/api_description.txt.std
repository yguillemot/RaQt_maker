                  Readable = 0x010,
                  Writable = 0x020,
                  Executable = 0x040,
                  PermissionMask = 0x070,

                  Modified = 0x080,
                  Hidden = 0x100,
                  System = 0x200,

                  AccessMask = 0x3F0,

                  AllDirs = 0x400,
