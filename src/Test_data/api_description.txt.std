public:
enum EncodingOption {
        SortKeysInMaps = 0x01,
        UseFloat = 0x02,

        UseFloat16 = UseFloat | 0x04,

        UseIntegers = 0x08,

        NoTransformation = 0
    };

typedef QFlags<EncodingOption> EncodingOptions;

    enum DiagnosticNotationOption {
        Compact = 0x00,
        LineWrapped = 0x01,
        ExtendedFormat = 0x02
    };

