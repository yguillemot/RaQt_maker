enum UsagePattern {
        StreamDraw = 0x88E0,
        StreamRead = 0x88E1,
        StreamCopy = 0x88E2,
        StaticDraw = 0x88E4,
        StaticRead = 0x88E5,
        StaticCopy = 0x88E6,
        DynamicDraw = 0x88E8,
        DynamicRead = 0x88E9,
        DynamicCopy = 0x88EA
    };

enum Access {
        ReadOnly = 0x88B8,
        WriteOnly = 0x88B9,
        ReadWrite = 0x88BA
    };

enum RangeAccessFlag {
        RangeRead = 0x0001,
        RangeWrite = 0x0002,
        RangeInvalidate = 0x0004,
        RangeInvalidateBuffer = 0x0008,
        RangeFlushExplicit = 0x0010,
        RangeUnsynchronized = 0x0020
    };

typedef QFlags<RangeAccessFlag> RangeAccessFlags;

     QOpenGLBuffer::Type    type() const ;
